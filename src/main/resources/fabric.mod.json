	"contact": {
		"sources": "https://github.com/cambrova/long-standing-bug-fixes",
		"issues": "https://github.com/cambrova/long-standing-bug-fixes/issues"
	},
	"license": "MIT",
	"icon": "assets/long_standing_fixes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.traelmyx.longstandingfixes.fabric.LongStandingFixesFabric"]
	},
	"mixins": ["long_standing_fixes.mixins.json"],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${mc_dep}",
		"java": ">=${java}"
	}
}
