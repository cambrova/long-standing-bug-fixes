	"contact": {
		"sources": "https://github.com/traelmyx/mojira-fix-pack",
		"issues": "https://github.com/traelmyx/mojira-fix-pack/issues"
	},
	"license": "MIT",
	"icon": "assets/mojira_fix_pack/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.traelmyx.mojirafixpack.fabric.MojiraFixPackFabric"]
	},
	"mixins": ["mojira_fix_pack.mixins.json"],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${mc_dep}",
		"java": ">=${java}"
	}
